<script>
document.addEventListener('DOMContentLoaded', function () {
    const deleteModal = document.getElementById('deleteCategoryModal');
    if (!deleteModal) return;

    deleteModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        if (!button) return;

        const id = button.getAttribute('data-id');
        const code = button.getAttribute('data-code');
        const name = button.getAttribute('data-name');

        const modalCode = document.getElementById('modalCategoryCode');
        const modalName = document.getElementById('modalCategoryName');
        const deleteForm = document.getElementById('deleteCategoryForm');

        if (modalCode) modalCode.textContent = code || ('L' + id);
        if (modalName) modalName.textContent = name || '';

        // Cập nhật URL action động tới route /category/delete/:id
        if (deleteForm && id) {
            deleteForm.action = '<?= $this->url('category') ?>/delete/' + encodeURIComponent(id);
        }
    });
});
</script>
