<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập - Quản lý loại sách</title>
    <!-- Thử nạp CDN Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        /* CSS tự định nghĩa để đảm bảo giao diện đẹp kể cả khi mất mạng CDN */
        * {
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        body {
            background-color: #f4f6f9;
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .login-card {
            width: 100%;
            max-width: 380px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 35px 30px;
            margin: auto;
        }
        .icon-header {
            text-align: center;
            margin-bottom: 12px;
        }
        .book-svg {
            width: 50px;
            height: 50px;
            fill: #0d6efd;
        }
        .title {
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }
        .subtitle {
            text-align: center;
            font-size: 13px;
            color: #6c757d;
            margin: 0 0 25px 0;
        }
        .form-group {
            margin-bottom: 18px;
        }
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 6px;
        }
        .input-wrapper {
            display: flex;
            align-items: center;
            border: 1px solid #ced4da;
            border-radius: 8px;
            background-color: #fff;
            overflow: hidden;
            transition: border-color 0.2s;
        }
        .input-wrapper:focus-within {
            border-color: #0d6efd;
        }
        .input-icon {
            padding: 10px 12px;
            background-color: #f8f9fa;
            color: #495057;
            border-right: 1px solid #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
        }
        .input-icon svg {
            width: 16px;
            height: 16px;
            fill: #495057;
        }
        .form-control-custom {
            width: 100%;
            padding: 10px 12px;
            border: none;
            outline: none;
            font-size: 14px;
            color: #495057;
        }
        .btn-submit {
            width: 100%;
            padding: 11px 0;
            background-color: #003352;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.2s;
        }
        .btn-submit:hover {
            background-color: #002238;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Biểu tượng cuốn sách chuẩn SVG (luôn hiển thị dù có mạng hay không) -->
        <div class="icon-header">
            <svg class="book-svg" viewBox="0 0 24 24">
                <path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/>
            </svg>
        </div>

        <!-- Tiêu đề -->
        <h2 class="title">Đăng Nhập</h2>
        <p class="subtitle">Ứng dụng quản lý loại sách</p>

        <!-- Form đăng nhập -->
        <form>
            <div class="form-group">
                <label class="form-label">Tên đăng nhập</label>
                <div class="input-wrapper">
                    <div class="input-icon">
                        <!-- Icon User SVG -->
                        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    </div>
                    <input type="text" class="form-control-custom" placeholder="Nhập tài khoản...">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <div class="input-wrapper">
                    <div class="input-icon">
                        <!-- Icon Lock SVG -->
                        <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    </div>
                    <input type="password" class="form-control-custom" placeholder="Nhập mật khẩu...">
                </div>
            </div>

            <button type="button" class="btn-submit">Đăng Nhập</button>
        </form>
    </div>

</body>
</html>